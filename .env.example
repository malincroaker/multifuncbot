# Create a NEW bot with @BotFather. Do not reuse a token from another running bot.
BOT_TOKEN=
DATABASE_PATH=data/multifuncbot.sqlite3
ENABLED_MODULES=guide,booking,leads,shop
DEFAULT_LANGUAGE=ru
TIMEZONE=Europe/Moscow
# showcase: each visitor has an isolated demo workspace.
# business: shared appointment slots; ADMIN_IDS can manage all customers.
APP_MODE=showcase
ADMIN_IDS=
# Leave empty to use the scenario menu. A client bot can open one module directly.
DEFAULT_MODULE=
ADMIN_CONTACT_URL=
# Telegram requires HTTPS for a Mini App; localhost is for browser preview only.
MINI_APP_URL=
HOST=127.0.0.1
PORT=8000
# Anonymous browser preview has an isolated cookie session. Disable for a client deployment.
ALLOW_BROWSER_DEMO=true
# Payment simulation only; no cards, charges or financial credentials.
PAYMENT_PROVIDER=demo
